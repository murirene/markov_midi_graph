{
  // Type-checking only. Node 24 runs the .ts files directly by stripping types,
  // so nothing is compiled to JavaScript and there is no build step.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,

    // Required for Node's type stripping: imports use real .ts file names,
    // type-only imports are marked `import type`, and no TS-only runtime
    // syntax (enums, namespaces, parameter properties) is allowed.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
