# Copy to .env (same folder) and fill in. .env is git-ignored.
#   cp .env.example .env && chmod 600 .env

# --- Backend HTTP server ---
# 127.0.0.1 keeps the API reachable only from this computer.
HOST=127.0.0.1
PORT=4000

# --- PostgreSQL connection (application role, not the superuser) ---
# These are the standard libpq names: both node-postgres (pg) and psql read them.
PGHOST=localhost
PGPORT=5432
PGDATABASE=markov_midi_graph_dev
PGUSER=markov_app
PGPASSWORD=replace-with-the-app-role-password
